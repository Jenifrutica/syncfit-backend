# SyncFit Edge backend environment. Copy to `.env` (git-ignored).

# PostgreSQL (default). Use SQLite for zero-config: sqlite:///./syncfit.db
SYNCFIT_DATABASE_URL=postgresql+psycopg://syncfit:syncfit@localhost:5432/syncfit

# Secret for signing JWTs (use a long random string in production).
BACKEND_SECRET_KEY=change-me-to-a-long-random-string-32+chars

# CORS origins (frontend dev server).
BACKEND_CORS_ORIGINS=http://localhost:3000


# AI reasoning (optional). Needed to translate/analyze gym machines.
# Get a key from OpenCode Go/Zen. Without it, machine text falls back to a copy.
REASONING_API_KEY=
REASONING_PRODUCT=go
REASONING_MODEL=deepseek-v4.1-flash
REASONING_FALLBACK_MODEL=gpt-6-luna
# Time budget (seconds): primary, backup, and whole-attempt deadline. The API is
# served by the ALB directly (180s idle), so DeepSeek gets real time.
REASONING_TIMEOUT=100
REASONING_FALLBACK_TIMEOUT=30
REASONING_DEADLINE=140
